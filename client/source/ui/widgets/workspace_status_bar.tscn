[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/widgets/workspace_status_bar.gd" id="1_wsbar"]

[node name="WorkspaceStatusBar" type="PanelContainer"]
script = ExtResource("1_wsbar")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Status" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
text = "Checking the workspace…"
clip_text = true
text_overrun_behavior = 3

[node name="RefreshBtn" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Re-check the workspace"
focus_mode = 0
text = "⟳"

[connection signal="pressed" from="Row/RefreshBtn" to="." method="_on_refresh_pressed"]

[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/widgets/bridge_status_bar.gd" id="1_brbar"]

[node name="BridgeStatusBar" type="PanelContainer"]
script = ExtResource("1_brbar")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Status" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
text = "Checking the bridge…"
clip_text = true
text_overrun_behavior = 3

[node name="InjectBtn" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Run the models endpoint into the running Rocket.Chat server (meteor shell)"
focus_mode = 0
text = "Inject"

[node name="RefreshBtn" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Re-check the bridge"
focus_mode = 0
text = "⟳"

[connection signal="pressed" from="Row/InjectBtn" to="." method="_on_inject_pressed"]
[connection signal="pressed" from="Row/RefreshBtn" to="." method="_on_refresh_pressed"]

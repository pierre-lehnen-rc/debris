[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/database/json_tab.gd" id="1_json0"]
[ext_resource type="PackedScene" path="res://source/ui/database/results_view.tscn" id="2_json1"]

[node name="JsonTab" type="VBoxContainer"]
theme_override_constants/separation = 0
script = ExtResource("1_json0")

[node name="Toolbar" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Toolbar"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ShowBtn" type="Button" parent="Toolbar/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Parse the JSON and show it below"
focus_mode = 0
text = "Show"

[node name="TitleLabel" type="Label" parent="Toolbar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "JSON"

[node name="Split" type="VSplitContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
split_offsets = PackedInt32Array(160)
split_offset = 160

[node name="JsonEdit" type="CodeEdit" parent="Split"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
placeholder_text = "{ } — type or paste a JSON object or array"
tab_input_mode = false
gutters_draw_line_numbers = true

[node name="Results" parent="Split" instance=ExtResource("2_json1")]
unique_name_in_owner = true
layout_mode = 2

[connection signal="pressed" from="Toolbar/Row/ShowBtn" to="." method="_show"]

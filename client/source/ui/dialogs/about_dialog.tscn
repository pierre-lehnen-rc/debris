[gd_scene format=3]

[ext_resource type="Theme" path="res://source/ui/theme/app_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://source/ui/dialogs/about_dialog.gd" id="2_about"]
[ext_resource type="Texture2D" path="res://icon.svg" id="3_icon"]

[node name="AboutDialog" type="Window"]
title = "About Debris"
size = Vector2i(360, 300)
visible = false
transient = true
transient_to_focused = true
exclusive = true
unresizable = true
min_size = Vector2i(360, 300)
theme = ExtResource("1_theme")
script = ExtResource("2_about")

[node name="Bg" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Col" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Icon" type="TextureRect" parent="Margin/Col"]
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
size_flags_horizontal = 4
texture = ExtResource("3_icon")
expand_mode = 1
stretch_mode = 5

[node name="AppName" type="Label" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Debris"
horizontal_alignment = 1

[node name="Version" type="Label" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
text = "Version 0.1.0"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Margin/Col"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2

[node name="Description" type="Label" parent="Margin/Col"]
unique_name_in_owner = true
layout_mode = 2
text = "A MongoDB and Rocket.Chat workspace client."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Col"]
layout_mode = 2
size_flags_vertical = 10
theme_override_constants/separation = 8
alignment = 1

[node name="CloseBtn" type="Button" parent="Margin/Col/Buttons"]
layout_mode = 2
text = "Close"

[connection signal="close_requested" from="." to="." method="hide"]
[connection signal="pressed" from="Margin/Col/Buttons/CloseBtn" to="." method="hide"]

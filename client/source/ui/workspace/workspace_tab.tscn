[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://source/ui/workspace/workspace_tab.gd" id="1_ws"]
[ext_resource type="PackedScene" path="res://source/ui/workspace/endpoint_sidebar.tscn" id="2_side"]
[ext_resource type="PackedScene" path="res://source/ui/workspace/endpoint_workspace.tscn" id="3_explorer"]
[ext_resource type="PackedScene" path="res://source/ui/workspace/users_panel.tscn" id="4_users"]

[node name="WorkspaceTab" type="Control"]
layout_mode = 3
anchors_preset = 0
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_ws")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 0

[node name="Toolbar" type="PanelContainer" parent="Col"]
unique_name_in_owner = true
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Col/Toolbar"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Spacer" type="Control" parent="Col/Toolbar/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="UsersToggle" type="Button" parent="Col/Toolbar/Row"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_pressed = true
text = "Users Panel"

[node name="Split" type="HSplitContainer" parent="Col"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 240

[node name="EndpointSidebar" parent="Col/Split" instance=ExtResource("2_side")]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="RightSplit" type="HSplitContainer" parent="Col/Split"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EndpointWorkspace" parent="Col/Split/RightSplit" instance=ExtResource("3_explorer")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="UsersPanel" parent="Col/Split/RightSplit" instance=ExtResource("4_users")]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2

[connection signal="toggled" from="Col/Toolbar/Row/UsersToggle" to="." method="_on_users_toggled"]
[connection signal="endpoint_activated" from="Col/Split/EndpointSidebar" to="." method="_on_endpoint_activated"]
[connection signal="status_changed" from="Col/Split/EndpointSidebar" to="." method="_on_status_changed"]
[connection signal="status_changed" from="Col/Split/RightSplit/EndpointWorkspace" to="." method="_on_status_changed"]
[connection signal="status_changed" from="Col/Split/RightSplit/UsersPanel" to="." method="_on_status_changed"]

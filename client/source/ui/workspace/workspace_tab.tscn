[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/workspace/workspace_tab.gd" id="1_wstab"]
[ext_resource type="PackedScene" path="res://source/ui/sidebar/collection_sidebar.tscn" id="2_coll"]
[ext_resource type="PackedScene" path="res://source/ui/workspace/workspace.tscn" id="3_ws"]

[node name="WorkspaceTab" type="Control"]
layout_mode = 3
anchors_preset = 0
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_wstab")

[node name="Split" type="HSplitContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
split_offset = 360

[node name="CollectionSidebar" parent="Split" instance=ExtResource("2_coll")]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Workspace" parent="Split" instance=ExtResource("3_ws")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[connection signal="collection_activated" from="Split/CollectionSidebar" to="." method="_on_collection_activated"]
[connection signal="insert_document_requested" from="Split/CollectionSidebar" to="." method="_on_insert_document_requested"]
[connection signal="status_changed" from="Split/CollectionSidebar" to="." method="_on_status_changed"]
[connection signal="status_changed" from="Split/Workspace" to="." method="_on_status_changed"]

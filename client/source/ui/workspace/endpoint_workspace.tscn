[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/workspace/endpoint_workspace.gd" id="1_epws"]

[node name="EndpointWorkspace" type="Control"]
layout_mode = 3
anchors_preset = 0
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_epws")

[node name="Tabs" type="TabContainer" parent="."]
unique_name_in_owner = true
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
tabs_rearrange_group = 0

[node name="Welcome" type="CenterContainer" parent="."]
unique_name_in_owner = true
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Box" type="VBoxContainer" parent="Welcome"]
layout_mode = 2
alignment = 1

[node name="WelcomeTitle" type="Label" parent="Welcome/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Rocket.Chat API"
horizontal_alignment = 1

[node name="WelcomeHint" type="Label" parent="Welcome/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Double-click an endpoint in the sidebar to open it."
horizontal_alignment = 1

[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/sidebar/connection_browser.gd" id="1_browser"]
[ext_resource type="Theme" path="res://source/ui/theme/app_theme.tres" id="2_theme"]

[node name="ConnectionBrowser" type="PanelContainer"]
script = ExtResource("1_browser")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Box/Header"]
layout_mode = 2

[node name="Title" type="Label" parent="Box/Header/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "CONNECTIONS"

[node name="AddBtn" type="Button" parent="Box/Header/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "New connection"
focus_mode = 0
text = "+"

[node name="Tree" type="Tree" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_neighbor_left = NodePath(".")
focus_neighbor_top = NodePath(".")
focus_neighbor_right = NodePath(".")
focus_neighbor_bottom = NodePath(".")
allow_rmb_select = true
hide_root = true
select_mode = 1

[node name="ContextMenu" type="PopupMenu" parent="."]
unique_name_in_owner = true
theme = ExtResource("2_theme")

[connection signal="pressed" from="Box/Header/Row/AddBtn" to="." method="_on_add_pressed"]
[connection signal="item_activated" from="Box/Tree" to="." method="_on_item_activated"]
[connection signal="item_mouse_selected" from="Box/Tree" to="." method="_on_item_mouse_selected"]
[connection signal="id_pressed" from="ContextMenu" to="." method="_on_context_action"]

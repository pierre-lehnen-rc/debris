[gd_scene format=3]

[ext_resource type="Script" path="res://source/ui/sidebar/collection_sidebar.gd" id="1_coll"]
[ext_resource type="Theme" path="res://source/ui/theme/app_theme.tres" id="2_theme"]

[node name="CollectionSidebar" type="PanelContainer"]
script = ExtResource("1_coll")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2

[node name="HeaderBox" type="VBoxContainer" parent="Box/Header"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Row" type="HBoxContainer" parent="Box/Header/HeaderBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Box/Header/HeaderBox/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "COLLECTIONS"

[node name="EditBtn" type="Button" parent="Box/Header/HeaderBox/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Edit database connection"
focus_mode = 0
text = "✎"

[node name="RefreshBtn" type="Button" parent="Box/Header/HeaderBox/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Refresh collections"
focus_mode = 0
text = "⟳"

[node name="SchemaRow" type="HBoxContainer" parent="Box/Header/HeaderBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SchemaLabel" type="Label" parent="Box/Header/HeaderBox/SchemaRow"]
layout_mode = 2
text = "Schema"

[node name="SchemaOption" type="OptionButton" parent="Box/Header/HeaderBox/SchemaRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Database schema"
focus_mode = 0
selected = 0
item_count = 3
popup/item_0/text = "Generic"
popup/item_0/id = 0
popup/item_1/text = "Rocket.Chat"
popup/item_1/id = 1
popup/item_2/text = "Flat"
popup/item_2/id = 2

[node name="Tree" type="Tree" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_neighbor_left = NodePath(".")
focus_neighbor_top = NodePath(".")
focus_neighbor_right = NodePath(".")
focus_neighbor_bottom = NodePath(".")
allow_rmb_select = true
hide_root = true
select_mode = 1

[node name="ContextMenu" type="PopupMenu" parent="."]
unique_name_in_owner = true
theme = ExtResource("2_theme")

[connection signal="pressed" from="Box/Header/HeaderBox/Row/EditBtn" to="." method="_on_edit_pressed"]
[connection signal="pressed" from="Box/Header/HeaderBox/Row/RefreshBtn" to="." method="_on_refresh_pressed"]
[connection signal="item_selected" from="Box/Header/HeaderBox/SchemaRow/SchemaOption" to="." method="_on_schema_selected"]
[connection signal="item_activated" from="Box/Tree" to="." method="_on_item_activated"]
[connection signal="item_mouse_selected" from="Box/Tree" to="." method="_on_item_mouse_selected"]
[connection signal="id_pressed" from="ContextMenu" to="." method="_on_context_action"]
